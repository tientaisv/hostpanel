# DockPulse Environment Configuration Template
# Rename this file to .env and fill in your values

# Server Identification (Distinguishes multiple VPS on a single Supabase project)
SERVER_NAME=vps-01

# Web App Port & Authentication
PORT=3800
ADMIN_USER=admin
ADMIN_PASS=change_this_secure_password

# Supabase Cloud Configuration for Long-Term Historical Resource Metrics Logging
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_or_service_role_key
METRICS_PUSH_INTERVAL_SEC=300

# AI Troubleshooting Assistant API Keys (Rotates through comma-separated keys)
GEMINI_KEYS=your_gemini_key_1,your_gemini_key_2
GROQ_KEYS=your_groq_key_1,your_groq_key_2
